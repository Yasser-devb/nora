/.phpunit.cache/
**/.phpunit.cache/
/coverage/
**/coverage/
/playwright-report/
**/playwright-report/
/test-results/
**/test-results/

# Logs, editor/OS files, and temporary files
*.log
*.tmp
*.temp
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Local-only data and database dumps
/private-data/
**/private-data/
/db-dumps/
**/db-dumps/
*.dump
*.sql.gz
*.sqlite
*.sqlite3

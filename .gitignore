# Composer and JavaScript dependencies
/vendor/
/node_modules/
**/vendor/
**/node_modules/

# Local environment files; keep the documented examples
/.env
/.env.*
!/.env.example
**/.env
**/.env.*
!**/.env.example

# Test, coverage, and browser-run output
/.phpunit.cache/
**/.phpunit.cache/
/coverage/
**/coverage/
/playwright-report/
**/playwright-report/
/test-results/
**/test-results/

# VS Code user settings and IDE metadata
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
/.vscode/extensions.json
.idea/

# Local private keys and generated distribution artifacts
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.vsix
/*.zip
/*.tar
/*.tar.gz

# Logs, editor/OS files, and temporary files
*.log
*.tmp
*.temp
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Local-only data and database dumps
/private-data/
**/private-data/
/db-dumps/
**/db-dumps/
*.dump
*.sql.gz
*.db
*.sqlite
*.sqlite3
*.bak
*.backup

# Keep separate project implementations local; retain the extension info page
/examples/nora-website/
/extensions/vscode-nora/**
!/extensions/vscode-nora/README.md
/tests/Integration/NoraWebsiteErrorPageTest.php
/tests/browser/nora-website.test.js

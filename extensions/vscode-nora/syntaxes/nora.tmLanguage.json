{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nora Template",
  "scopeName": "text.html.nora",
  "patterns": [
    {
      "include": "#interpolation"
    },
    {
      "include": "#include-directive"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "interpolation": {
      "name": "meta.interpolation.nora",
      "begin": "\\{\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.nora"
        }
      },
      "end": "\\}\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.nora"
        }
      },
      "patterns": [
        {
          "name": "variable.other.nora",
          "match": "[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*"
        }
      ]
    },
    "include-directive": {
      "name": "meta.directive.include.nora",
      "begin": "\\{%\\s*(?=include\\b)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.directive.begin.nora"
        }
      },
      "end": "\\s*%\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.directive.end.nora"
        }
      },
      "patterns": [
        {
          "name": "keyword.control.include.nora",
          "match": "\\binclude\\b"
        },
        {
          "name": "string.quoted.double.nora",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nora"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nora"
            }
          },
          "patterns": [
            {
              "name": "entity.name.path.nora",
              "match": "[A-Za-z0-9_/-]+"
            }
          ]
        },
        {
          "name": "string.quoted.single.nora",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nora"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nora"
            }
          },
          "patterns": [
            {
              "name": "entity.name.path.nora",
              "match": "[A-Za-z0-9_/-]+"
            }
          ]
        }
      ]
    }
  }
}

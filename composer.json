{
  "name": "morave/nora",
  "description": "Independent modular PHP framework created in Morocco by Morave Technologies",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/Yasser-devb/nora",
  "keywords": [
    "framework",
    "http",
    "morocco",
    "mvc",
    "nora",
    "php",
    "routing"
  ],
  "support": {
    "issues": "https://github.com/Yasser-devb/nora/issues",
    "source": "https://github.com/Yasser-devb/nora"
  },
  "require": {
    "php": "^8.2",
    "ext-filter": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-session": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Nora\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Nora\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/nora"
  ],
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite Unit",
    "check": [
      "@composer validate --strict",
      "@composer audit",
      "@composer test -- --display-warnings"
    ]
  },
  "archive": {
    "exclude": [
      "/.env",
      "/.env.*",
      "!/.env.example",
      "/.github/**",
      "/.phpunit.cache/**",
      "/.vscode/**",
      "/coverage/**",
      "/examples/**",
      "/extensions/**",
      "/node_modules",
      "/node_modules/",
      "/node_modules/**",
      "/playwright-report/**",
      "/test-results/**",
      "/tests/**",
      "/vendor/**",
      "/composer.lock",
      "/package-lock.json",
      "/package.json",
      "/phpunit.xml"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
